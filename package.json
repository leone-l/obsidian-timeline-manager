{
  "name": "obsidian-timeline-manager",
  "version": "1.0.0",
  "description": "Obsidian plugin to visually create and manage timelines stored in markdown.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "esbuild test/roundtrip.test.ts --bundle --format=esm --platform=node --outfile=dist/roundtrip.mjs --log-level=warning && node dist/roundtrip.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "obsidian",
    "timeline",
    "plugin"
  ],
  "author": "Timeline Manager",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.7",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.3",
    "obsidian": "1.4.11",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  }
}
